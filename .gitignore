# Rack plugin build outputs
/build/
/dist/
/plugin.dylib
/plugin.dll
/plugin.so

# Python bytecode from capture scripts
__pycache__/
*.pyc
*.pyo

# Adapted from https://github.com/github/gitignore:
# Global/macOS.gitignore, Global/Windows.gitignore, Global/Linux.gitignore,
# and C++.gitignore. Keep Makefiles, research data, and source assets visible;
# build directories above are scoped to RackNES's actual output locations.

# C++ dependency, object, and precompiled header files
*.d
*.slo
*.lo
*.o
*.obj
*.gch
*.pch

# C++ libraries and executables
*.so
*.so.*
*.dylib
*.dll
*.lai
*.la
*.a
*.lib
*.exe
*.app/

# Linker and debugging artifacts
*.ilk
*.pdb
*.dwo
*.dSYM/
*.stackdump

# macOS Finder metadata and resource forks
.DS_Store
.localized
__MACOSX/
.AppleDouble
.LSOverride
._*

# macOS volume and network-share metadata
.DocumentRevisions-V100/
.fseventsd/
.Spotlight-V100/
.TemporaryItems/
.Trashes/
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder/
Temporary Items/
.apdisk

# Windows thumbnail caches and folder metadata
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux filesystem and desktop metadata
.fuse_hidden*
.directory
.Trash-*/
.nfs*
nohup.out

# Editor backup and swap files
*~
*.swp
*.swo
